# syntax=docker/dockerfile:1.7-labs
# Minimal NFS host image.
#
# This file deliberately has no relationship with the OFS image entrypoint or
# its baked plugin/catalog layers. The host and its app-next artefact are
# selected explicitly at runtime by app-config.nfs.yaml.

ARG NODE_BASE_RUNTIME=registry.access.redhat.com/ubi10/nodejs-22-minimal:10.2-1785373147@sha256:a2a29192d6f52e76f514fe8f763752c7e3c97110b1e3903b07d21cb11a49ccc1
ARG NPM_REGISTRY=https://registry.npmjs.org/

FROM ${NODE_BASE_RUNTIME}

USER root

# Runtime-only tools: OCI dynamic-plugin installation and Python YAML parsing.
# No compiler toolchain is installed; all application compilation happens before
# this image is built.
RUN microdnf install -y --nodocs --setopt=install_weak_deps=0 \
      skopeo jq tar gzip ca-certificates python3.12 python3.12-pip && \
    microdnf clean all && \
    rm -rf /var/cache/dnf /var/cache/yum /var/cache/libdnf5 && \
    ln -sf /usr/bin/python3.12 /usr/bin/python3 && \
    ln -sf /usr/bin/python3.12 /usr/bin/python

RUN python3.12 -m pip install --no-cache-dir 'PyYAML==6.0.2'

RUN npm install -g corepack && \
    corepack enable && \
    corepack prepare yarn@4.12.0 --activate

RUN mkdir -p /opt/app-root/src/.npm /opt/app-root/src/.cache && \
    chown -R 1001:0 /opt/app-root/src/.npm /opt/app-root/src/.cache

USER 1001
WORKDIR /app

ARG NPM_REGISTRY
ARG DEVPORTAL_VERSION=dev
ENV NPM_REGISTRY=${NPM_REGISTRY} \
    NPM_CONFIG_REGISTRY=${NPM_REGISTRY} \
    YARN_REGISTRY=${NPM_REGISTRY} \
    NODE_ENV=production \
    NODE_OPTIONS=--no-node-snapshot \
    ENABLE_STANDARD_MODULE_FEDERATION=true \
    NFS_KUBERNETES_FIXTURE=/app/packages/app-next/fixtures/kubernetes-control.yaml

# The backend build emits these two archives. The skeleton contains workspace
# manifests, while the bundle contains the compiled backend and selected app
# artefacts.
COPY --chown=1001:0 .yarn ./.yarn
COPY --chown=1001:0 yarn.lock package.json backstage.json ./
RUN --mount=type=bind,source=packages/backend/dist/skeleton.tar.gz,target=/tmp/skeleton.tar.gz \
    tar xzf /tmp/skeleton.tar.gz

RUN yarn config set npmRegistryServer "$NPM_REGISTRY" && \
    yarn config set nodeLinker node-modules && \
    if [ "$NPM_REGISTRY" != "https://registry.npmjs.org/" ]; then \
      HOST=$(printf '%s\n' "$NPM_REGISTRY" | awk -F[/:] '{print $4}') && \
      yarn config set unsafeHttpWhitelist --json "[\"localhost\",\"$HOST\"]"; \
    fi && \
    cp .yarnrc.yml "$HOME/.yarnrc.yml"

# Install only production workspace dependencies. Keep config declarations and
# Backstage declarations because the backend validates dynamic-plugin schemas at
# startup; this is the same runtime constraint as the OFS image.
RUN --mount=type=cache,target=/opt/app-root/src/.yarn/berry/cache,sharing=locked,uid=1001,gid=0 \
    --mount=type=cache,target=/opt/app-root/src/.yarn/berry/index,sharing=locked,uid=1001,gid=0 \
    yarn workspaces focus --all --production && \
    find node_modules -type f \( -name '*.map' -o -name '*.md' -o -name '*.markdown' -o -name '*.flow' \) -delete && \
    find node_modules -type f -name '*.d.ts' ! -name 'config.d.ts' \
      ! -path '*node_modules/typescript/*' \
      ! -path 'node_modules/@backstage/*' \
      ! -path 'node_modules/@backstage-community/*' \
      ! -path 'node_modules/@veecode-platform/*' \
      ! -path 'node_modules/@internal/*' \
      -delete && \
    find node_modules -type d \( -name '__tests__' -o -name '__mocks__' \) -prune -exec rm -rf {} +

RUN node -e "require('better-sqlite3'); console.log('native deps OK: better-sqlite3 loaded')"

RUN --mount=type=bind,source=packages/backend/dist/bundle.tar.gz,target=/tmp/bundle.tar.gz \
    tar xzf /tmp/bundle.tar.gz && \
    find packages -type f -name '*.map' -delete

# Make the NFS selection and static reference explicit in the image. The
# compiled frontend is already in bundle.tar.gz; the checks below turn a stale
# or incomplete host build into a build failure rather than a runtime mystery.
COPY --chown=1001:0 packages/app-next/package.json ./packages/app-next/package.json
COPY --chown=1001:0 packages/app-next/fixtures ./packages/app-next/fixtures
RUN test -f packages/app-next/dist/index.html && \
    ls packages/app-next/dist/static/main.*.js >/dev/null && \
    node -e "const p=require.resolve('app-next/package.json'); if (require(p).name !== 'app-next') process.exit(1); console.log('NFS app selected:', p)"

COPY --chown=1001:0 examples ./examples
COPY --chown=1001:0 rbac-policy.csv /app/
COPY --chown=1001:0 rbac-policy-extensions.csv /tmp/
RUN cat /tmp/rbac-policy-extensions.csv >> /app/rbac-policy.csv && \
    rm /tmp/rbac-policy-extensions.csv

COPY --chown=1001:0 app-config.yaml app-config.production.yaml app-config.nfs.yaml ./
COPY --chown=1001:0 docker/install-dynamic-plugins.py /app/install-dynamic-plugins.py
COPY --chown=1001:0 --chmod=755 docker/entrypoint.nfs.sh /app/entrypoint.nfs.sh
COPY --chown=1001:0 docker/dynamic-plugins.nfs.yaml /app/dynamic-plugins.nfs.yaml

RUN mkdir -p /app/dynamic-plugins-root /app/data

RUN printf '{"version":"%s"}\n' "$DEVPORTAL_VERSION" > /app/devportal.json

VOLUME /app/data

ENTRYPOINT ["/app/entrypoint.nfs.sh"]
